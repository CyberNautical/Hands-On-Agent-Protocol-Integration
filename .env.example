# =============================================================================
# Azure OpenAI configuration
# =============================================================================
# Copy this file to `.env` and fill in the values below.
#
#     cp .env.example .env
#
# This is the ONLY paid resource in the workshop. Everything else -- the MCP
# server, both A2A servers, the dev UI -- runs locally in your Codespace.
#
# There are two ways to authenticate. Pick one:
#
#   A) API key            -- fastest to get going, set AZURE_API_KEY below.
#   B) Entra ID (keyless) -- managed identity / `az login`, no secret in .env.
#                            See the "Keyless" section further down.
# =============================================================================

# Your API key, from the Azure portal (Keys and Endpoint) or AI Foundry.
# Leave BLANK if you are using keyless (Entra ID) authentication.
AZURE_API_KEY=

# The resource endpoint. Include the scheme, no trailing path.
#   e.g. https://my-resource.openai.azure.com
#        https://my-resource.services.ai.azure.com   (AI Foundry)
#
# Copy only the host. If the portal shows you a full URL such as
# .../openai/v1/responses, drop everything from /openai onward -- LiteLLM
# appends its own path, and leaving it in produces a 404.
AZURE_API_BASE=

# The API version. It MUST support tool/function calling -- older versions do
# not, and the failure looks like the model simply ignoring your tools.
#
# Which value you need depends on the kind of resource:
#
#   v1           AI Foundry resources (*.services.ai.azure.com). These serve
#                the newer /openai/v1/ surface and return 404 for the older
#                /openai/deployments/... route, whatever date you put here.
#   2024-10-21   Classic Azure OpenAI resources (*.openai.azure.com). A safe,
#                widely available dated version.
#
# If you get "Resource not found" with a dated version, try v1.
AZURE_API_VERSION=v1

# The name of your DEPLOYMENT, not the model.
#
# This trips up almost everyone. In Azure you deploy a model and give that
# deployment a name of your choosing. If you deployed gpt-4o and called the
# deployment "gpt-4o-prod", the value here is "gpt-4o-prod".
# Using the model name when they differ produces a 404.
AZURE_OPENAI_DEPLOYMENT=

# =============================================================================
# Keyless authentication with Entra ID / managed identity (optional)
# =============================================================================
# Rather than a shared key, you can authenticate as an Azure identity:
#
#   * a managed identity, when running on an Azure VM, Container App or AKS
#   * your own account locally, via `az login` or the VS Code Azure sign-in
#
# All of them are handled by DefaultAzureCredential, so the setup is the same.
#
# Requirements:
#   1. Install the extra dependency:   uv sync --group entra
#   2. Grant the identity the "Cognitive Services OpenAI User" role on the
#      Azure OpenAI resource. Without it you get a 401/403, not a config error.
#   3. Leave AZURE_API_KEY blank (or set AZURE_AUTH_MODE=entra explicitly).
#
# auto  = use the key if AZURE_API_KEY is set, otherwise Entra ID  (default)
# key   = always use AZURE_API_KEY
# entra = always use Entra ID, and fail loudly if it cannot get a token
#
# AZURE_AUTH_MODE=auto

# Only for a USER-assigned managed identity -- the client ID of that identity.
# Leave unset for system-assigned identities or for local `az login`.
#
# AZURE_CLIENT_ID=

# Token audience. The default is correct for Azure OpenAI; override only if you
# are pointing at a sovereign cloud.
#
# AZURE_TOKEN_SCOPE=https://cognitiveservices.azure.com/.default

# =============================================================================
# Ports (optional -- defaults shown)
# =============================================================================
# 8000  MCP server        (FastMCP, Streamable HTTP)
# 8001  A2A server        (adk api_server --a2a, hosts billing_agent)
# 8002  ADK dev web UI    (adk web)
# 8003  Interop A2A       (to_a2a, Section 3)
#
# MCP_PORT=8000
# A2A_PORT=8001
# WEB_PORT=8002
# INTEROP_PORT=8003
