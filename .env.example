# =============================================================================
# Azure OpenAI configuration
# =============================================================================
# Copy this file to `.env` and fill in the four values below.
#
#     cp .env.example .env
#
# This is the ONLY paid resource in the workshop. Everything else -- the MCP
# server, both A2A servers, the dev UI -- runs locally in your Codespace.
# =============================================================================

# Your API key, from the Azure portal (Keys and Endpoint) or AI Foundry.
AZURE_API_KEY=

# The resource endpoint. Include the scheme, no trailing path.
#   e.g. https://my-resource.openai.azure.com
AZURE_API_BASE=

# The API version. It MUST support tool/function calling -- older versions do
# not, and the failure looks like the model simply ignoring your tools.
# 2024-10-21 is a safe, widely available choice.
AZURE_API_VERSION=2024-10-21

# The name of your DEPLOYMENT, not the model.
#
# This trips up almost everyone. In Azure you deploy a model and give that
# deployment a name of your choosing. If you deployed gpt-4o and called the
# deployment "gpt-4o-prod", the value here is "gpt-4o-prod".
# Using the model name when they differ produces a 404.
AZURE_OPENAI_DEPLOYMENT=

# =============================================================================
# Ports (optional -- defaults shown)
# =============================================================================
# 8000  MCP server        (FastMCP, Streamable HTTP)
# 8001  A2A server        (adk api_server --a2a, hosts billing_agent)
# 8002  ADK dev web UI    (adk web)
# 8003  Interop A2A       (to_a2a, Section 3)
#
# MCP_PORT=8000
# A2A_PORT=8001
# WEB_PORT=8002
# INTEROP_PORT=8003
