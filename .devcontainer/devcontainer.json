{
  // ==========================================================================
  // Codespaces devcontainer.
  //
  // The goal here is zero setup at demo time. Everything installs while the
  // Codespace is being created, so when you open a terminal you can run the
  // first lab command immediately.
  // ==========================================================================
  "name": "Agent Protocol Integration",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  "features": {
    // uv resolves and installs the whole dependency set in seconds.
    "ghcr.io/va-h/devcontainers-features/uv:1": {
      "version": "latest"
    }
  },

  // Install dependencies at build time, not demo time.
  "postCreateCommand": "uv sync && cp -n .env.example .env || true",

  "forwardPorts": [8000, 8001, 8002, 8003],
  "portsAttributes": {
    "8000": { "label": "MCP server" },
    "8001": { "label": "A2A server" },
    "8002": { "label": "ADK dev UI", "onAutoForward": "openPreview" },
    "8003": { "label": "Interop agent" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        // `import helpdesk` works in notebooks and the editor without an
        // install step, because the repo is run in place.
        "python.analysis.extraPaths": ["${containerWorkspaceFolder}/src"],
        "terminal.integrated.env.linux": {
          "PYTHONPATH": "${containerWorkspaceFolder}/src"
        }
      }
    }
  },

  "remoteEnv": {
    "PYTHONPATH": "${containerWorkspaceFolder}/src"
  }
}
